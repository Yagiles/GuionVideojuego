  lineas:
  - nombrePersonaje: Bell
    texto: "(<i>bostezo<i>) \r\n\r\n"
  - nombrePersonaje: Bell
    texto: " Oh\u2026 Por fin lleg\xE1is.\r\n\r\n"
  - nombrePersonaje: Bell
    texto: "\xBFY bien? \xBFTen\xE9is algo que me ayude?\r\n"
  - nombrePersonaje: "T\xFA"
    texto: "S\xED. Nos han dado esta almohada.\r\n\r\n"
  - nombrePersonaje: Bell
    texto: "\xA1Oh! \xA1Bien hecho, bien hecho!\r\n\r\n"
  - nombrePersonaje: Bell
    texto: 'Tomad. Lo prometido es deuda.



'
  - nombrePersonaje: "T\xFA"
    texto: "\xBFUna...servilleta usada?\r\n\r\n"
  - nombrePersonaje: "T\xFA"
    texto: "\xBFDe qu\xE9 me sirve a mi esto?\r\n\r\n"
  - nombrePersonaje: Bell
    texto: 'No juzgues a un libro por su mugre.



'
  - nombrePersonaje: "T\xFA"
    texto: "As\xED no...\r\n\r\n"
  - nombrePersonaje: "T\xFA"
    texto: En fin, gracias.Supongo
  avanceAutomatico: 0
  duracionLinea: 2
